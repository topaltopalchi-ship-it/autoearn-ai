# AutoEarn AI local owner authentication
# Use a long random value for the password.
AUTOEARN_MASTER_PASSWORD=replace-with-a-strong-local-password
# Use a separate random value for signing local sessions.
AUTOEARN_AUTH_SECRET=replace-with-a-long-random-secret

