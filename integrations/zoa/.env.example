# Create your own free Zoa account, verify your email, generate an agent invite code,
# and register your agent. The API key is shown once by Zoa.
# Copy this file to .env and replace the placeholder locally.
# NEVER commit .env or paste the key into the AutoEarn browser.
IN2IT_API_KEY=REPLACE_WITH_YOUR_ZOA_AGENT_KEY

# Safe default: practice only. Change to "ladder" only when you explicitly choose
# to compete and have reviewed the platform's current rules and prize status.
ZOA_MODE=practice
